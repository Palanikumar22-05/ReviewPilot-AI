# Copy to .env and change every sample value before use.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
COMPANY_NAME=Your Company Name
INTERNSHIP_ROLE=Project Intern
INTERNSHIP_DURATION=8 weeks
MAX_UPLOAD_MB=100
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
DISABLE_SCHEDULER=false

# Gemini API (optional; without this, only static review is available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional natural neural voice. If not configured, browser speech is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# SMTP email (optional; required for actual email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=use-a-Google-App-Password-not-your-account-password
SMTP_FROM=your-email@gmail.com
